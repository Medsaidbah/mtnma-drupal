{# Photo gallery tile: the article image, linking to the article. #}
<figure>
<a href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.alt }}"{% if item.position %} style="object-position:{{ item.position }}"{% endif %} loading="lazy">
<figcaption>{{ item.title }}</figcaption>
</a>
</figure>
