{#
/**
 * @file
 * Homepage sections, rendered for the node set as the site front page.
 *
 * Variables (mtnma_preprocess_node__front()):
 * - hero_slides: Sticky articles {url, title, image, alt, position, eyebrow}.
 * - top_news: Latest articles {url, title, image, alt, date, iso, archive}.
 * - media_news: Articles continuing the list, with a summary.
 * - services: Promoted services {title, description, url, link_text, icon}.
 * - links: Internal URLs keyed by page (media, services, minister...).
 * - images: Base URL of the theme images directory.
 */
#}
{% import '@mtnma/includes/icons.twig' as icons %}
{% set hero_count = hero_slides|length %}
<section class="hero" aria-roledescription="{{ 'carousel'|t }}" aria-label="{{ 'Featured news'|t }}">
<h1 class="visually-hidden">{{ 'Ministry of Digital Transformation and Administrative Modernization'|t }}</h1>
<div class="hero-slides" id="hero-slides" aria-live="off">
{% for slide in hero_slides %}
<article class="hero-slide{{ loop.first ? ' is-active' }}" id="hero-slide-{{ loop.index }}" role="tabpanel" aria-roledescription="{{ 'slide'|t }}" aria-label="{{ '@index of @count'|t({'@index': loop.index, '@count': hero_count}) }}">
<div class="hero-media"><img src="{{ slide.image }}" alt="{{ slide.alt }}"{% if slide.position %} style="object-position:{{ slide.position }}"{% endif %} {{ loop.first ? 'fetchpriority="high"' : 'decoding="async"' }}></div>
<div class="wrap hero-content">
<div class="eyebrow">{{ slide.eyebrow }}</div>
<h2 class="hero-title">{{ slide.title }}</h2>
<a class="btn gold" href="{{ slide.url }}">{{ 'Read the article'|t }} {{ icons.arrow() }}
</a>
</div>
</article>
{% endfor %}
</div>
<div class="social-rail">
{% for network in social_links|slice(0, 3) %}
<a href="{{ network.url }}" target="_blank" rel="noopener" aria-label="{{ network.label }}">{{ icons.brand(network.icon) }}
</a>
{% endfor %}
</div>
{% if hero_count > 1 %}
<div class="hero-controls">
<div class="hero-dots" role="tablist" aria-label="{{ 'Featured news'|t }}">
{% for slide in hero_slides %}
<button class="hero-dot" role="tab" id="hero-tab-{{ loop.index }}" aria-controls="hero-slide-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %} aria-label="{{ 'News item @index'|t({'@index': loop.index}) }}"><span class="hero-dot-fill"></span>
</button>
{% endfor %}
</div>
<button class="hero-toggle" id="hero-toggle" aria-label="{{ 'Pause automatic scrolling'|t }}">{{ icons.ui('pause') }}{{ icons.ui('play') }}
</button>
</div>
{% endif %}
</section>
<section class="stats">
<div class="wrap">
<div class="stats-heading">
<h2>{{ 'The Ministry in figures'|t }}</h2>
<p>{{ 'Indicators published in the Ministry archive'|t }}</p>
</div>
<div class="stat"><strong dir="ltr">70%</strong><span>{{ 'Internet penetration rate'|t }}</span>
</div>
<div class="stat"><strong dir="ltr">168%</strong><span>{{ 'Mobile phone penetration · 2022'|t }}</span>
</div>
<div class="stat"><strong>4000 <small>{{ 'km'|t }}</small></strong><span>{{ 'Optical fibre · 2021'|t }}</span>
</div>
</div>
</section>
{% if top_news %}
{% set feature = top_news|first %}
<section class="section soft">
<div class="wrap">
<div class="section-head">
<div>
<h2>{{ 'Top news'|t }}</h2>
<p>{{ 'Follow Ministry news and digital transformation activities'|t }}</p>
</div>
<a href="{{ links.media }}" class="text-link">{{ 'All news'|t }}{{ icons.arrow() }}
</a>
</div>
<div class="news-layout">
<a href="{{ feature.url }}" class="news-feature"><img src="{{ feature.image }}" alt="{{ feature.alt }}" loading="lazy">
<div class="caption">{% include '@mtnma/includes/news-date.html.twig' with {item: feature} %}
<h3>{{ feature.title }}</h3>
</div>
</a>
<div class="news-list">
{% for item in top_news|slice(1) %}
<a class="news-row" href="{{ item.url }}"><img src="{{ item.image }}" alt="" loading="lazy">
<div>{% include '@mtnma/includes/news-date.html.twig' %}
<h3>{{ item.title }}</h3>
</div>
</a>
{% endfor %}
<a class="btn" href="{{ links.media }}">{{ 'Explore the Media Centre'|t }} {{ icons.arrow() }}
</a>
</div>
</div>
</div>
</section>
{% endif %}
{% if services %}
<section class="section">
<div class="wrap">
<div class="section-head">
<div>
<h2>{{ 'Digital services'|t }}</h2>
<p>{{ 'Your procedures, closer to you. Choose a service and go directly to its official portal.'|t }}</p>
</div>
<a href="{{ links.services }}" class="text-link">{{ 'All services'|t }}{{ icons.arrow() }}
</a>
</div>
<div class="services-grid">
{% for service in services %}
<article class="service-card"><span class="service-icon">{{ icons.ui(service.icon) }}</span>
<h3>{{ service.title }}</h3>
<p>{{ service.description }}</p>
{% if service.url %}
<a class="text-link" href="{{ service.url }}" target="_blank" rel="noopener noreferrer">{{ service.link_text ?: 'Go to the service'|t }}{{ icons.external() }}
</a>
{% endif %}
</article>
{% endfor %}
</div>
<div class="service-footer">
<div>{{ 'Clear services, simpler steps'|t }}<p>{{ 'A single portal to discover government platforms and access them.'|t }}</p>
</div>
<a class="text-link" href="{{ links.services }}">{{ 'Find your service'|t }} {{ icons.arrow() }}
</a>
</div>
</div>
</section>
{% endif %}
<section class="section soft">
<div class="wrap about-grid">
<article class="minister-card"><img src="{{ images }}/minister.jpg" alt="{{ 'Mr. Ahmed Salem Bede'|t }}" loading="lazy">
<div>
<h3>{{ 'Mr. Ahmed Salem Bede'|t }}</h3>
<p>{{ 'Minister of Digital Transformation and Administrative Modernization'|t }}</p>
<a class="btn" href="{{ links.minister }}">{{ 'About the Minister'|t }} {{ icons.arrow() }}
</a>
</div>
</article>
<div class="about-content"><span class="overline">{{ 'About the Ministry'|t }}</span>
<h2>{{ 'Digital transformation serving the citizen'|t }}</h2>
<p>{{ 'Learn about the missions of the Ministry and its bodies, and explore the policies and initiatives aimed at developing public services and making use of digital tools.'|t }}</p>
<div class="quick-grid">
{% for card in [
  {page: 'organization', icon: 'building', title: 'Organization chart'|t, text: 'Organization and operation'|t},
  {page: 'agencies', icon: 'people', title: 'Supervised bodies'|t, text: 'Complementary institutions'|t},
  {page: 'strategies', icon: 'document', title: 'Strategies and policies'|t, text: 'Vision and priorities of the sector'|t},
  {page: 'indicators', icon: 'chart', title: 'Sector indicators'|t, text: 'Data on digital transformation'|t},
] %}
<a class="quick-card" href="{{ links[card.page] }}">{{ icons.ui(card.icon) }}
<div>
<h3>{{ card.title }}</h3>
<p>{{ card.text }}</p>
</div>
</a>
{% endfor %}
</div>
</div>
</div>
</section>
<section class="section axes">
<div class="wrap">
<h2>{{ 'Areas of action of the Ministry'|t }}</h2>
<p>{{ 'Integrated paths to build a digital future that serves everyone'|t }}</p>
<div class="axes-grid">
{% for axis in [
  {page: 'projects', icon: 'network', title: 'Infrastructure'|t, text: 'Strengthening connectivity, developing digital infrastructure and hosting data.'|t},
  {page: 'strategies', icon: 'building', title: 'Administrative modernization'|t, text: 'Simplifying procedures and improving the experience of public service users.'|t},
  {page: 'innovation', icon: 'bulb', title: 'Innovation'|t, text: 'Supporting new solutions and entrepreneurship in the digital field.'|t},
  {page: 'about', icon: 'globe', title: 'Digital transformation'|t, text: 'Developing the policies and tools that support the digitization of services.'|t},
] %}
<article class="axis">{{ icons.ui(axis.icon) }}
<h3>{{ axis.title }}</h3>
<p>{{ axis.text }}</p>
<a href="{{ links[axis.page] }}">{{ 'Learn more'|t }} {{ icons.arrow() }}
</a>
</article>
{% endfor %}
</div>
</div>
</section>
{% if media_news %}
<section class="section">
<div class="wrap">
<div class="section-head">
<div>
<h2>{{ 'Media Centre'|t }}</h2>
<p>{{ 'News and events from the Ministry archive'|t }}</p>
</div>
<a href="{{ links.media }}" class="text-link">{{ 'See more'|t }}{{ icons.arrow() }}
</a>
</div>
<div class="news-grid">
{% for item in media_news %}
<article class="news-card">
<a href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.alt }}" loading="lazy">
</a>
<div class="card-body">{% include '@mtnma/includes/news-date.html.twig' %}
<h3>
<a href="{{ item.url }}">{{ item.title }}</a>
</h3>
<p>{{ item.summary }}</p>
<a class="text-link" href="{{ item.url }}">{{ 'Read the news'|t }} {{ icons.arrow() }}
</a>
</div>
</article>
{% endfor %}
</div>
</div>
</section>
{% endif %}
