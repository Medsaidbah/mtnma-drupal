{#
/**
 * @file
 * News card in the Media Centre listing (item: see _mtnma_article_item()).
 */
#}
{% import '@mtnma/includes/icons.twig' as icons %}
<article class="news-card">
<a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
{%- if item.image -%}
<img src="{{ item.image }}" alt=""{% if item.position %} style="object-position:{{ item.position }}"{% endif %} loading="lazy">
{%- else -%}
<span class="news-card-placeholder"><img src="{{ images }}/seal.png" alt="" loading="lazy"></span>
{%- endif -%}
</a>
<div class="card-body">{% include '@mtnma/includes/news-date.html.twig' %}
<h3>
<a href="{{ item.url }}">{{ item.title }}</a>
</h3>
{% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
<a class="text-link" href="{{ item.url }}" aria-hidden="true" tabindex="-1">{{ 'Read the news'|t }} {{ icons.arrow() }}
</a>
</div>
</article>
