<?php

/**
 * @file
 * Functions to support theming in the mtnma theme.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Internal pages linked from the homepage sections, keyed by template name.
 */
const MTNMA_PAGES = [
  'about', 'minister', 'organization', 'agencies', 'strategies', 'indicators',
  'projects', 'innovation', 'media', 'services',
];

/**
 * Order of the mobile menu and the search dialog's page list, as in the
 * replica; pages missing here follow in menu order.
 */
const MTNMA_PAGE_ORDER = [
  '', '/about', '/minister', '/organization', '/agencies', '/services',
  '/strategies', '/studies', '/indicators', '/laws', '/media', '/gallery',
  '/projects', '/innovation', '/tenders', '/contact', '/links',
];

/**
 * Social networks shown in the hero rail (first three) and the footer.
 */
const MTNMA_SOCIAL = [
  ['icon' => 'facebook', 'label' => 'Facebook', 'url' => 'https://www.facebook.com/mtnimarim'],
  ['icon' => 'x', 'label' => 'X', 'url' => 'https://twitter.com/mtnima_mr'],
  ['icon' => 'linkedin', 'label' => 'LinkedIn', 'url' => 'https://www.linkedin.com/company/mtnima/'],
  ['icon' => 'youtube', 'label' => 'YouTube', 'url' => 'https://www.youtube.com/@mtnima_rim'],
];

/**
 * Returns the URL of the theme images directory.
 */
function _mtnma_images_url(): string {
  return base_path() . \Drupal::service('extension.list.theme')->getPath('mtnma') . '/images';
}

/**
 * Returns the current content language code.
 */
function _mtnma_langcode(): string {
  return \Drupal::languageManager()->getCurrentLanguage()->getId();
}

/**
 * Implements hook_preprocess_html().
 */
function mtnma_preprocess_html(array &$variables): void {
  $langcode = _mtnma_langcode();
  $fonts = \Drupal::service('extension.list.theme')->getPath('mtnma') . '/images/';
  // Arabic pages are set in Almarai, the others in Figtree.
  $variables['font_preload'] = $langcode === 'ar'
    ? ['href' => base_path() . $fonts . 'Almarai-Regular.ttf', 'type' => 'font/ttf']
    : ['href' => base_path() . $fonts . 'Figtree-latin.woff2', 'type' => 'font/woff2'];

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['page']['#attached']['html_head'][] = [[
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'description',
        'content' => t('Ministry of Digital Transformation and Administrative Modernization — services, news and strategies'),
      ],
    ], 'mtnma_description'];
  }
}

/**
 * Implements hook_preprocess_page().
 */
function mtnma_preprocess_page(array &$variables): void {
  $langcode = _mtnma_langcode();
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $cache->addCacheContexts(['languages', 'url.path', 'route.menu_active_trails:main', 'route.menu_active_trails:footer']);
  $cache->addCacheTags(['config:system.menu.main', 'config:system.menu.footer']);

  $variables['images'] = _mtnma_images_url();
  // The official wordmark images are Arabic; other languages use text.
  $variables['text_wordmarks'] = $langcode !== 'ar';
  $variables['social_links'] = MTNMA_SOCIAL;
  $variables['official_site_url'] = $langcode === 'fr' ? 'https://mtnima.gov.mr/fr/' : 'https://mtnima.gov.mr/';
  $variables['language_switch'] = _mtnma_language_switch($langcode);

  $main = _mtnma_menu_tree('main');
  $footer = _mtnma_menu_tree('footer');
  $variables['main_nav'] = $main;
  $variables['footer_columns'] = array_map(fn($column) => ['title' => $column['title'], 'links' => $column['children']], $footer);

  // Mobile menu and search finder: every main menu page, then any footer page
  // not already listed (photo gallery, useful links).
  $pages = [];
  foreach ([$main, $footer] as $tree) {
    foreach ($tree as $item) {
      foreach ($item['children'] ?: [$item] as $page) {
        if ($page['url'] !== '' && !isset($pages[$page['url']])) {
          $pages[$page['url']] = $page;
        }
      }
    }
  }
  $prefix = '#^' . preg_quote(base_path() . $langcode, '#') . '(?=/|$)#';
  $position = fn(array $page) => array_search(rtrim(preg_replace($prefix, '', $page['url']), '/'), MTNMA_PAGE_ORDER, TRUE);
  uasort($pages, fn(array $a, array $b) => ($position($a) === FALSE ? PHP_INT_MAX : $position($a)) <=> ($position($b) === FALSE ? PHP_INT_MAX : $position($b)));
  $variables['all_pages'] = array_values($pages);
  $variables['search_url'] = Url::fromRoute('search.view_node_search')->toString();

  // Node pages show their title in the replica's page banner; section pages
  // add their lead and the bar of related pages below it.
  $route = \Drupal::routeMatch();
  $node = $route->getParameter('node');
  if ($node instanceof NodeInterface && $route->getRouteName() === 'entity.node.canonical') {
    $node = \Drupal::service('entity.repository')->getTranslationFromContext($node, $langcode);
    $variables['page_banner'] = ['title' => $node->label()];
    if ($node->hasField('field_lead')) {
      $variables['page_banner']['lead'] = $node->get('field_lead')->value;
      $variables['subnav'] = _mtnma_related_pages($node, $langcode, $cache);
    }
    elseif ($node->bundle() === 'article') {
      // News articles link back to the Media Centre and the photo gallery.
      $variables['subnav'] = _mtnma_page_links(['/media', '/gallery'], $langcode, $cache);
    }
    $cache->addCacheableDependency($node);
  }
  elseif ($route->getRouteName() === 'search.view_node_search') {
    $variables['page_banner'] = [
      'title' => t('Search the site'),
      'lead' => t('Pages, news and digital services of the Ministry.'),
    ];
    $variables['wrap_content'] = TRUE;
  }
  if (!empty($variables['page_banner']) || !empty($variables['is_front'])) {
    unset($variables['page']['content']['mtnma_page_title']);
  }
  $cache->applyTo($variables);
}

/**
 * Returns the "related pages" bar of a section page.
 *
 * @return array
 *   Links {title, url, active}, in the editor's order.
 */
function _mtnma_related_pages(NodeInterface $node, string $langcode, CacheableMetadata $cache): array {
  $links = [];
  foreach ($node->get('field_related')->referencedEntities() as $related) {
    if (!$related->access('view') || !$related->hasTranslation($langcode)) {
      continue;
    }
    $related = $related->getTranslation($langcode);
    $cache->addCacheableDependency($related);
    $links[] = [
      'title' => $related->label(),
      'url' => $related->toUrl()->toString(),
      'active' => $related->id() === $node->id(),
    ];
  }
  return $links;
}

/**
 * Returns links to section pages given by path, such as "/media".
 *
 * @return array
 *   Links {title, url, active} to the pages that exist in $langcode.
 */
function _mtnma_page_links(array $paths, string $langcode, CacheableMetadata $cache): array {
  $links = [];
  foreach ($paths as $path) {
    $url = \Drupal::service('path.validator')->getUrlIfValidWithoutAccessCheck($path);
    $page = $url && $url->isRouted() && $url->getRouteName() === 'entity.node.canonical'
      ? \Drupal::entityTypeManager()->getStorage('node')->load($url->getRouteParameters()['node'])
      : NULL;
    if (!$page || !$page->access('view') || !$page->hasTranslation($langcode)) {
      continue;
    }
    $page = $page->getTranslation($langcode);
    $cache->addCacheableDependency($page);
    $links[] = ['title' => $page->label(), 'url' => $page->toUrl()->toString(), 'active' => FALSE];
  }
  return $links;
}

/**
 * Builds the link to the same page in the other site language.
 */
function _mtnma_language_switch(string $langcode): ?array {
  $target = $langcode === 'ar' ? 'fr' : 'ar';
  $language = \Drupal::languageManager()->getLanguage($target);
  if (!$language) {
    return NULL;
  }
  $route = \Drupal::service('path.matcher')->isFrontPage() ? '<front>' : '<current>';
  $url = Url::fromRoute($route, [], ['language' => $language]);
  return [
    'url' => $url->toString(),
    'langcode' => $target,
    'dir' => $language->getDirection(),
    'label' => $target === 'fr' ? 'Français' : 'العربية',
    'short' => $target === 'fr' ? 'FR' : 'ع',
  ];
}

/**
 * Loads a two-level menu as plain arrays for the replica templates.
 *
 * @return array
 *   Items with keys title, url, active and children (same shape, no children).
 */
function _mtnma_menu_tree(string $menu_name): array {
  $tree_service = \Drupal::menuTree();
  $parameters = (new MenuTreeParameters())->setMaxDepth(2)->onlyEnabledLinks();
  $active = \Drupal::service('menu.active_trail')->getActiveTrailIds($menu_name);
  $tree = $tree_service->transform($tree_service->load($menu_name, $parameters), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $build = function (array $elements) use (&$build, $active): array {
    $items = [];
    foreach ($elements as $element) {
      if (!$element->access?->isAllowed()) {
        continue;
      }
      $link = $element->link;
      $url = $link->getUrlObject();
      $items[] = [
        'title' => $link->getTitle(),
        'url' => $url->isRouted() && $url->getRouteName() === '<nolink>' ? '' : $url->toString(),
        // A dropdown parent is never itself the current page.
        'active' => isset($active[$link->getPluginId()]) && !$element->subtree,
        'children' => $build($element->subtree),
      ];
    }
    return $items;
  };
  return $build($tree);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node templates.
 */
function mtnma_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'];
  if ($variables['elements']['#view_mode'] === 'full' && _mtnma_is_front_node($node)) {
    $suggestions[] = 'node__front';
  }
}

/**
 * Checks whether a node is the one configured as the site front page.
 */
function _mtnma_is_front_node(NodeInterface $node): bool {
  $front = \Drupal::config('system.site')->get('page.front');
  return $front === '/node/' . $node->id();
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function mtnma_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $view_mode = $variables['view_mode'];
  if ($view_mode === 'full' && _mtnma_is_front_node($node)) {
    _mtnma_preprocess_front($variables);
  }
  elseif ($node->bundle() === 'article' && in_array($view_mode, ['full', 'teaser', 'photo'], TRUE)) {
    $item = _mtnma_article_item($node);
    $variables['item'] = $item;
    $variables['images'] = _mtnma_images_url();
    if ($view_mode === 'full') {
      $variables['article_meta'] = $item;
      $variables['article_image'] = $item['image'] ? ['url' => $item['image'], 'alt' => $item['alt'], 'position' => $item['position']] : NULL;
      $variables['media_url'] = Url::fromUserInput('/media')->toString();
      $source = $node->get('field_source_link')->first();
      $variables['source_url'] = $source ? $source->getUrl()->toString() : NULL;
      $checked = $node->get('field_source_checked')->date;
      $variables['source_checked'] = $checked ? \Drupal::service('date.formatter')->format($checked->getTimestamp(), 'custom', 'j F Y', NULL, $node->language()->getId()) : NULL;
    }
  }
  elseif ($node->bundle() === 'service' && in_array($view_mode, ['full', 'teaser'], TRUE)) {
    $variables['service'] = _mtnma_service_item($node);
    $variables['services_url'] = Url::fromUserInput('/services')->toString();
  }
  elseif ($node->bundle() === 'page' && $view_mode === 'full' && $node->hasField('field_listing')) {
    // Section pages with a Drupal listing (news, services, photos) show it
    // above their body text.
    $listing = $node->get('field_listing')->value;
    if ($listing) {
      $variables['listing'] = views_embed_view("mtnma_$listing", 'embed_1');
      $variables['listing_class'] = $listing === 'gallery' ? 'content-section' : 'content-section soft';
    }
  }
}

/**
 * Flattens a digital service into the values the replica templates print.
 */
function _mtnma_service_item(NodeInterface $node): array {
  $link = $node->get('field_service_link')->first();
  return [
    'title' => $node->label(),
    'description' => $node->get('field_service_description')->value,
    'url' => $link ? $link->getUrl()->toString() : '',
    'link_text' => $link?->title,
    'icon' => $node->get('field_service_icon')->value ?: 'document',
    'page_url' => $node->toUrl()->toString(),
  ];
}

/**
 * Prepares the homepage sections from article and service nodes.
 */
function _mtnma_preprocess_front(array &$variables): void {
  $langcode = _mtnma_langcode();
  $variables['images'] = _mtnma_images_url();
  $variables['social_links'] = MTNMA_SOCIAL;
  $variables['links'] = [];
  foreach (MTNMA_PAGES as $page) {
    $variables['links'][$page] = Url::fromUserInput('/' . $page)->toString();
  }

  // Hero: sticky articles. News: latest promoted articles; the Media Centre
  // block continues the list from the fourth item, as in the replica.
  $hero = _mtnma_load_nodes('article', $langcode, ['sticky' => 1], 3);
  $latest = _mtnma_load_nodes('article', $langcode, ['promote' => 1], 6);
  $variables['hero_slides'] = array_map(function (NodeInterface $node) {
    $item = _mtnma_article_item($node);
    $hero = $node->get('field_hero_image')->first();
    if ($hero?->entity) {
      $item['image'] = \Drupal::service('file_url_generator')->generateString($hero->entity->getFileUri());
      $item['alt'] = $hero->alt ?? '';
    }
    $item['title'] = $node->get('field_hero_title')->value ?: $item['title'];
    $item['eyebrow'] = $item['archive']
      ? t('From the Ministry archive')
      : t('Ministry news · @date', ['@date' => $item['date']]);
    return $item;
  }, $hero);
  $items = array_map('_mtnma_article_item', $latest);
  $variables['top_news'] = array_slice($items, 0, 4);
  $variables['media_news'] = array_slice($items, 3, 3);

  $variables['services'] = array_map('_mtnma_service_item', _mtnma_load_nodes('service', $langcode, ['promote' => 1], 12, 'ASC'));

  $variables['#cache']['tags'][] = 'node_list';
  $variables['#cache']['contexts'][] = 'languages';
}

/**
 * Loads published nodes of a bundle in the given language, newest first.
 *
 * @return \Drupal\node\NodeInterface[]
 *   Nodes translated into $langcode.
 */
function _mtnma_load_nodes(string $bundle, string $langcode, array $conditions, int $limit, string $direction = 'DESC'): array {
  $query = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', $bundle)
    ->condition('status', 1)
    ->condition('langcode', $langcode)
    ->sort('created', $direction)
    ->sort('nid', $direction)
    ->range(0, $limit);
  foreach ($conditions as $field => $value) {
    $query->condition($field, $value);
  }
  $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($query->execute());
  return array_values(array_map(fn(NodeInterface $node) => $node->getTranslation($langcode), $nodes));
}

/**
 * Flattens an article into the values the replica templates print.
 */
function _mtnma_article_item(NodeInterface $node): array {
  $image = $node->get('field_image')->first();
  $file = $image?->entity;
  $created = $node->getCreatedTime();
  $body = $node->get('body')->first();
  return [
    'url' => $node->toUrl()->toString(),
    'title' => $node->label(),
    'image' => $file ? \Drupal::service('file_url_generator')->generateString($file->getFileUri()) : '',
    'alt' => $image?->alt ?? '',
    'position' => $node->get('field_image_position')->value,
    'archive' => (bool) $node->get('field_archive')->value,
    'category' => match ($node->get('field_category')->value) {
      'news' => t('Ministry news'),
      'events' => t('Events', [], ['context' => 'mtnma']),
      default => NULL,
    },
    'date' => \Drupal::service('date.formatter')->format($created, 'custom', 'j F Y', NULL, $node->language()->getId()),
    'iso' => date('Y-m-d', $created),
    'summary' => $body ? ($body->summary ?: text_summary(strip_tags($body->value), NULL, 200)) : '',
  ];
}

/**
 * Filter buttons of the listings, keyed by view ID: query value => label.
 */
function _mtnma_listing_filters(string $view_id): array {
  return match ($view_id) {
    'mtnma_news' => [
      '' => t('All', [], ['context' => 'mtnma']),
      'news' => t('Ministry news'),
      'events' => t('Events', [], ['context' => 'mtnma']),
    ],
    'mtnma_services' => [
      '' => t('All services'),
      'citizens' => t('Citizens'),
      'business' => t('Businesses'),
      'education' => t('Education and family'),
    ],
    default => [],
  };
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 *
 * The news and services listings print the replica's filter bar: category
 * links and a keyword box, read by the view's exposed filters ("category"
 * and "keys" in the query string).
 */
function mtnma_preprocess_views_view(array &$variables): void {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];
  if (!str_starts_with($view->id(), 'mtnma_')) {
    return;
  }
  $input = $view->getExposedInput();
  $category = is_string($input['category'] ?? NULL) ? $input['category'] : '';
  $keys = is_string($input['keys'] ?? NULL) ? trim($input['keys']) : '';
  $variables['filter_links'] = [];
  foreach (_mtnma_listing_filters($view->id()) as $value => $label) {
    $query = array_filter(['category' => $value, 'keys' => $keys], 'strlen');
    $variables['filter_links'][] = [
      'label' => $label,
      'url' => Url::fromRoute('<current>', [], ['query' => $query])->toString(),
      'active' => $value === $category,
    ];
  }
  $variables['listing_grid'] = match ($view->id()) {
    'mtnma_services' => 'services-grid',
    'mtnma_gallery' => 'photo-grid',
    default => 'news-grid',
  };
  $services = $view->id() === 'mtnma_services';
  $variables['filter_label'] = $services ? t('Search for a service') : t('Search the news');
  $variables['filter_placeholder'] = $services ? t('Search for a service…') : t('Search the news…');
  $variables['filter_category'] = $category;
  $variables['filter_keys'] = $keys;
  $variables['filter_action'] = Url::fromRoute('<current>')->toString();
  $total = (int) ($view->pager?->getTotalItems() ?? count($view->result));
  $variables['result_count'] = _mtnma_result_count($view, $total);
}

/**
 * Returns the "N news items" line printed above a listing.
 */
function _mtnma_result_count(ViewExecutable $view, int $total): string {
  if ($total === 0) {
    return (string) t('No results match your search.');
  }
  return (string) match ($view->id()) {
    'mtnma_services' => \Drupal::translation()->formatPlural($total, '1 service', '@count services'),
    'mtnma_gallery' => \Drupal::translation()->formatPlural($total, '1 photo', '@count photos'),
    default => \Drupal::translation()->formatPlural($total, '1 news item', '@count news items'),
  };
}

/**
 * Implements hook_preprocess_HOOK() for search_result.
 */
function mtnma_preprocess_search_result(array &$variables): void {
  $node = $variables['result']['node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  $variables['type_label'] = match ($node->bundle()) {
    'article' => t('News', [], ['context' => 'mtnma']),
    'service' => t('Digital service'),
    default => t('Page', [], ['context' => 'mtnma']),
  };
  if ($node->bundle() === 'article') {
    $variables['item'] = _mtnma_article_item($node);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for search_form.
 *
 * Gives the results page search box the replica's look; the advanced search
 * options stay available to editors who have that permission.
 */
function mtnma_form_search_form_alter(array &$form): void {
  $form['#attributes']['class'][] = 'site-search-form';
  if (isset($form['basic']['keys'])) {
    $form['basic']['keys']['#title_display'] = 'invisible';
    $form['basic']['keys']['#attributes']['placeholder'] = t('Search pages, news and services');
  }
  if (isset($form['basic']['submit'])) {
    $form['basic']['submit']['#attributes']['class'][] = 'btn';
  }
  unset($form['help_link']);
}

/**
 * Implements hook_theme_suggestions_alter().
 *
 * The site listings (views tagged "mtnma") share the *--mtnma-listing
 * templates.
 */
function mtnma_theme_suggestions_alter(array &$suggestions, array $variables, string $hook): void {
  if (in_array($hook, ['views_view', 'views_view_unformatted', 'views_view_fields'], TRUE)
    && ($variables['view'] ?? NULL) instanceof ViewExecutable
    && $variables['view']->storage->get('tag') === 'mtnma') {
    $suggestions[] = $hook . '__mtnma_listing';
  }
}
