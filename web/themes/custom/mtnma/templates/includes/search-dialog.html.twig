{#
/**
 * @file
 * Header search: a keyword form for the site search (search_url), with a
 * quick finder over all_pages that interactions.js filters while typing.
 */
#}
{% import '@mtnma/includes/icons.twig' as icons %}
<dialog id="search-dialog" aria-labelledby="search-title">
<div class="dialog-head">
<h2 id="search-title">{{ 'Search the site'|t }}</h2>
<button class="icon-btn" data-close aria-label="{{ 'Close search'|t }}">{{ icons.ui('close') }}
</button>
</div>
<form class="dialog-search" action="{{ search_url }}" method="get" role="search">
<label for="site-search">{{ 'Search pages, news and services'|t }}</label>
<div class="dialog-search-row"><input id="site-search" name="keys" type="search" required placeholder="{{ 'Example: digital services'|t }}"><button class="btn" type="submit">{{ 'Search'|t }}</button></div>
</form>
<p class="dialog-subtitle">{{ 'Site pages'|t }}</p>
<div id="search-results">
{% for item in all_pages %}
<a href="{{ item.url }}">{{ item.title }}{{ icons.arrow() }}
</a>
{% endfor %}
</div>
<p id="search-empty" hidden>{{ 'No page title matches. Press Search to look in all content.'|t }}</p></dialog>
